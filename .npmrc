# Default to the public npm registry (explicit, so resolution is unambiguous).
registry=https://registry.npmjs.org/

# --- Dependabot / GitHub Packages -------------------------------------------------
# GitHub auto-injects a GitHub Packages credential (npm.pkg.github.com) into Dependabot
# for this account (the `automatic-github-packages-auth` behaviour). Without a matching
# registry declaration in the repo, Dependabot aborts file-fetching with
# "Private npm registries require either a .npmrc file ... Registry: npm.pkg.github.com",
# which is why it could not rebase or group any PRs.
#
# This repo consumes ZERO packages from GitHub Packages, so we satisfy that requirement
# by declaring the registry for an unused placeholder scope. No real dependency uses
# @ghp-unused, so this changes nothing about how actual packages resolve (everything
# comes from public npm above), but it gives Dependabot the registry config it requires.
@ghp-unused:registry=https://npm.pkg.github.com
