# DeerDawn self-hosting configuration (read by the root docker-compose.yml).
#
# Do not copy this by hand: run ./scripts/selfhost/init.sh, which writes .env
# from this file with fresh secrets. It never overwrites an existing .env.
# Full guide: docs/self-hosting.md

# ─── Where people reach DeerDawn ─────────────────────────────────────────────
# One origin for the dashboard AND the API (MCP clients connect to
# $DEERDAWN_PUBLIC_URL/mcp). Scheme + host + optional port, no path.
DEERDAWN_PUBLIC_URL=http://localhost:3000
# Host port and interface Caddy listens on in plain-HTTP mode. 127.0.0.1 keeps
# it local to this machine; use 0.0.0.0 to expose it on your network (and then
# set DEERDAWN_PUBLIC_URL to the address people will actually type).
DEERDAWN_HTTP_PORT=3000
DEERDAWN_BIND_ADDRESS=127.0.0.1

# HTTPS on a real domain (automatic certificates). Uncomment all three.
# COMPOSE_FILE=docker-compose.yml:infra/selfhost/docker-compose.https.yml
# DEERDAWN_DOMAIN=deerdawn.example.com
# DEERDAWN_PUBLIC_URL=https://deerdawn.example.com

# ─── Mode ────────────────────────────────────────────────────────────────────
SELF_HOSTED=true
# invite_only (default): the FIRST account to sign up becomes the owner; after
# that, people join by invitation. open: anyone who can reach the URL can sign up.
SIGNUP_MODE=invite_only
# Product telemetry. Off unless you set this to true.
TELEMETRY_ENABLED=false
# Where the dashboard's "Source code" link points. DeerDawn is AGPL-3.0: if you
# run a MODIFIED version that others use over the network, section 13 requires
# offering them its source, so set this to your fork. Unset: the upstream repo.
# SOURCE_CODE_URL=https://github.com/HissingSpider/DeerDawn

# ─── Secrets (generated by init.sh) ──────────────────────────────────────────
POSTGRES_PASSWORD=__GENERATE__
JWT_SECRET=__GENERATE__
# Full-access machine key for the API (X-Api-Key). Keep it private.
DEERDAWN_SYSTEM_API_KEY=__GENERATE__
# 64 hex chars (AES-256). Context is encrypted at rest with it.
# BACK THIS UP. Losing it makes every encrypted brief permanently unreadable;
# a database backup without this key cannot be restored into anything useful.
ENCRYPTION_MASTER_KEY=__GENERATE__

# ─── LLM (extraction of decisions/tasks from sessions) ───────────────────────
# Any OpenAI-compatible chat-completions endpoint.
#   OpenAI:      LLM_API_URL=https://api.openai.com/v1        LLM_MODEL=gpt-4o-mini
#   Ollama:      LLM_API_URL=http://host.docker.internal:11434/v1   LLM_MODEL=llama3.1   (LLM_API_KEY empty)
#   OpenRouter:  LLM_API_URL=https://openrouter.ai/api/v1     LLM_MODEL=openai/gpt-4o-mini
LLM_API_URL=https://api.openai.com/v1
# Falls back to OPENAI_API_KEY when empty. May stay empty for Ollama.
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Embeddings for search. Default text-embedding-3-small on OpenAI; on any other
# URL they are used only when set (Ollama: nomic-embed-text). Leave unset for
# OpenRouter: the built-in local embedding is used.
# LLM_EMBEDDING_MODEL=
# Raise for slow local models (Ollama: 120000). Ollama also needs
# OLLAMA_CONTEXT_LENGTH=8192 or more on its side. docs/self-hosting.md#choosing-an-llm
# LLM_TIMEOUT_MS=60000

# ─── Images ──────────────────────────────────────────────────────────────────
# Prebuilt images from GHCR. Pin a release (e.g. 1.2.0) for reproducible
# upgrades; `latest` follows the newest release. `docker compose build` builds
# them from this checkout instead.
DEERDAWN_IMAGE_REGISTRY=ghcr.io/hissingspider
DEERDAWN_VERSION=latest

# ─── Optional ────────────────────────────────────────────────────────────────
# Swagger UI at /docs.
# DOCS_ENABLED=true
# Outbound email via Resend (password resets, invitations, digests).
# RESEND_API_KEY=
# RESEND_FROM=DeerDawn <deerdawn@example.com>
# GitHub token for importing skills from public repos (raises the rate limit).
# GITHUB_TOKEN=
