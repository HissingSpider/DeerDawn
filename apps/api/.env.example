# API (apps/api) environment.
#
# Two kinds of deployment read this file:
#   - SELF-HOSTED: use the repo-root docker-compose.yml + scripts/selfhost/init.sh,
#     which generate and wire everything below that is required. See
#     docs/self-hosting.md. Variables marked [HOSTED-ONLY] are not needed there.
#   - HOSTED (deerdawn.com): every variable below as documented.
# [HOSTED-ONLY] = used by the deerdawn.com service (billing, vendor analytics,
# ad conversions, managed auth). Leave unset when self-hosting.

# ─── Mode (self-hosting contract) ────────────────────────────────────────────
# SELF_HOSTED=true turns billing off, makes vendors optional and telemetry off
# by default, and uses local email/password auth (AUTH_PROVIDER unset).
SELF_HOSTED=
# Product telemetry (PostHog etc.). Defaults to false when SELF_HOSTED=true.
TELEMETRY_ENABLED=
# invite_only (default; the first signup becomes the owner) | open
SIGNUP_MODE=
# Source of the running version, shown as the dashboard's "Source code" link
# (AGPL-3.0 section 13). Set it to your fork if you run a modified version.
# Default: https://github.com/HissingSpider/DeerDawn
SOURCE_CODE_URL=

# ─── Extraction LLM ──────────────────────────────────────────────────────────
# Any OpenAI-compatible chat-completions endpoint (OpenAI, OpenRouter, Ollama, vLLM...).
LLM_API_URL=https://api.openai.com/v1
# Falls back to OPENAI_API_KEY when unset. May be empty for Ollama.
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=
# Legacy name, still read: the key used when LLM_API_KEY is unset.
OPENAI_API_KEY=sk-...  # Used by POST /api/v1/context/extraction (LLM pipeline)

# Encryption (required when storing context-source credentials; also enables AES-256-GCM context encryption for eligible plans)
# Generate with: openssl rand -hex 32
# 64 hex characters. REQUIRED for context to be encrypted at rest — encryption is
# gated on this variable alone, so an empty value means everything is stored in
# plaintext. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# BACK IT UP BEFORE USING IT IN PRODUCTION: per-owner DEKs are wrapped with this
# key, so losing it makes every encrypted brief permanently unreadable.
ENCRYPTION_MASTER_KEY=

# Infrastructure
PORT=8080
DATABASE_URL=postgres://postgres:password@localhost:5432/deerdawn_dev
REDIS_URL=redis://localhost:6379
JWT_SECRET=dev-secret-do-not-use-in-prod
DEERDAWN_API_KEY=dev-key

# Database Connection Pool (optional, defaults are production-safe)
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_IDLE_TIMEOUT=30000 # Close idle connections after 30s
DB_CONNECTION_TIMEOUT=30000 # 30s connection timeout for multi-region
DB_MAX_LIFETIME=600000 # Force connection rotation after 10 min
DB_STATEMENT_TIMEOUT=25000 # 25s statement timeout

# Auth (Clerk) [HOSTED-ONLY]. Leave AUTH_PROVIDER unset for local email/password auth
# (self-hosting). The hosted production deploy sets AUTH_PROVIDER=clerk.
AUTH_PROVIDER=local
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Billing (Stripe) [HOSTED-ONLY]. Not used when SELF_HOSTED=true.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Stripe subscription price IDs — canonical business catalog
STRIPE_PRICE_STARTER_MONTHLY=price_xxx
STRIPE_PRICE_STARTER_ANNUAL=price_xxx
STRIPE_PRICE_GROWTH_MONTHLY=price_xxx
STRIPE_PRICE_GROWTH_ANNUAL=price_xxx
# Metered overrun prices are required for Growth checkout in this app.
STRIPE_PRICE_GROWTH_OVERRUN_MONTHLY=price_xxx
STRIPE_PRICE_GROWTH_OVERRUN_ANNUAL=price_xxx
STRIPE_PRICE_SCALE_MONTHLY=price_xxx
STRIPE_PRICE_SCALE_ANNUAL=price_xxx
# Metered overrun prices are required for Scale checkout in this app.
STRIPE_PRICE_SCALE_OVERRUN_MONTHLY=price_xxx
STRIPE_PRICE_SCALE_OVERRUN_ANNUAL=price_xxx
# Optional internal-only catalog
# STRIPE_PRICE_PILOT=price_...
# Optional legacy aliases accepted during migration
# STRIPE_PRICE_STARTER=price_xxx
# STRIPE_PRICE_GROWTH=price_xxx
# STRIPE_PRICE_SCALE=price_xxx
# INDIVIDUAL (developer_basic) — $12/mo and $96/yr. The monthly one is REQUIRED
# for Individual checkout (validateCheckoutCatalog 503s without it).
# STRIPE_PRICE_DEVELOPER_BASIC=price_...
# STRIPE_PRICE_DEVELOPER_BASIC_ANNUAL=price_...
# Every SUPERSEDED price must stay listed here. Stripe prices are immutable, so
# a price rise means a NEW price with existing subscribers left on the old one.
# webhooks-stripe.js maps priceId -> plan from these vars and falls back to
# 'free' for anything it cannot map — so dropping the old id silently downgrades
# a customer who is still paying. Holds the $10/mo price superseded 2026-08-28.
STRIPE_PRICE_DEVELOPER_BASIC_LEGACY=
# TEAM (developer_pro) — $15 per SEAT per month / $150 per seat per year. Both are REQUIRED for
# Team checkout: it is in SELF_SERVE_PLAN_IDS, so marketing /pricing, the
# dashboard /checkout and /settings/upgrade all offer it a cart.
# validateCheckoutCatalog throws "Missing Stripe base price for developer_pro
# (…)" when the monthly one is unset, which billing.js returns as a 503 the
# buyer can actually read — it used to 500 as internal_error and tell them to
# retry something that could never succeed.
# If _ANNUAL is unset, getBasePriceId degrades an annual checkout to the MONTHLY
# price and logs loudly: a monthly sale beats no sale, and Stripe shows the real
# cadence before anyone pays — but that is a misconfiguration to fix, not a
# steady state. STRIPE_PRICE_MAX_MONTHLY / STRIPE_PRICE_MAX_ANNUAL, an older
# spelling, are still mapped to Team for existing subscribers but are not what
# checkout charges.
# STRIPE_PRICE_DEVELOPER_PRO=price_...
# STRIPE_PRICE_DEVELOPER_PRO_ANNUAL=price_...
# STRIPE_PRICE_STANDARD_BASE=price_...
# STRIPE_PRICE_GROWTH_BASE=price_...
# STRIPE_PRICE_PRO_BASE=price_...
# STRIPE_PRICE_PERSONAL_BASIC=price_...
# STRIPE_PRICE_PERSONAL_DEVELOPER=price_...

# URLs
DASHBOARD_URL=http://localhost:3000
MARKETING_URL=http://localhost:3001 # Marketing site URL (added to CORS allow-list)
# Comma-separated browser origins allowed to preflight the remote MCP endpoint.
# Defaults include Claude and ChatGPT production hosts when omitted.
MCP_CLIENT_ORIGINS=https://claude.ai,https://chatgpt.com,https://chat.openai.com
# Temporary publisher/domain challenge support. Set both values only while a
# directory verification is active; the filename must be a plain basename.
DOMAIN_VERIFICATION_FILENAME=
DOMAIN_VERIFICATION_CONTENT=
# Remote MCP call guardrails. The defaults bound a single call to 30 seconds,
# 64 concurrent requests per API instance, and 120 requests/minute per tenant/IP.
MCP_TOOL_TIMEOUT_MS=30000
MCP_MAX_CONCURRENCY=64
MCP_RATE_LIMIT_PER_MINUTE=120
# Nightly auto-archive of idle projects. Soft-archive only — nothing is deleted
# and the user can restore any project, which grants it a fresh window.
#
# On by default: start_session now names archived projects and offers the
# restore call instead of showing an empty workspace, so aging out is
# recoverable rather than silent. Set false to stop the sweep entirely.
PROJECT_AUTO_ARCHIVE_ENABLED=true
PROJECT_AUTO_ARCHIVE_DAYS=30
PROJECT_AUTO_ARCHIVE_BATCH=500
# Opt-in interactive task-board resource for MCP App-capable chat hosts.
# Keep false while the current ChatGPT submission is under review.
MCP_TASK_BOARD_UI_ENABLED=false
# HTTPS origins allowed to supply OAuth Client ID Metadata Documents (CIMD).
# Keep this narrow: the authorization server fetches these documents server-side.
# Setting this at all REPLACES the built-in default, so anything left out here
# stops being able to connect; the default in routes/oauth.js is the list to
# start from.
CIMD_ALLOWED_ORIGINS=https://chatgpt.com,https://claude.ai,https://vscode.dev
NEXT_PUBLIC_API_URL=http://localhost:8080
API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3001
MAC_DOWNLOAD_URL=https://downloads.deerdawn.com/Deerdawn.dmg # [HOSTED-ONLY] public /download flow

# Security
ALLOW_LOCALHOST=true # Allow localhost origins in CORS for local development (disable in production)
# DB_CA_CERT=... # Base64-encoded CA cert for TLS connections to managed Postgres (Fly, RDS, Supabase)
DOCS_ENABLED=true # Serve Swagger UI at /docs (disable in production)
CLIENT_LOGS_SHARED_SECRET=... # Shared secret for client-side log ingestion endpoint (/api/v1/logs)

# Observability
# METRICS_TOKEN=... # Bearer token to protect the /metrics endpoint (recommended in production)
# METRICS_ALLOWED_IPS=... # Comma-separated IP allowlist for /metrics (e.g. "10.0.0.1,10.0.0.2")

# Runtime
# SHUTDOWN_TIMEOUT_MS=10000 # Graceful shutdown window in ms (default: 10000)

# Rate Limiting (optional, defaults work well)
ENABLE_REDIS_RATE_LIMIT=true
RATE_LIMIT_FALLBACK=memory # Options: 'memory', 'none', 'off', 'disabled'
TRUST_PROXY_HOPS=1 # Number of trusted proxies (1 for Fly.io, adjust for your setup)

# JWT Hardening (recommended for production)
JWT_ISSUER=deerdawn-api-dev
JWT_AUDIENCE=deerdawn-dashboard-dev
JWT_EXPIRY=1h # JWT token expiration (default: 1h, can use 7d for development)

# Authentication Defaults (optional)
# Org-scoped roles: read-only < member < owner. First user of a new org is 'owner'.
# 'admin' is NOT a platform superuser — platform privileges come only from PLATFORM_ADMIN_EMAILS.
AUTH_DEFAULT_ROLE=owner
# AUTH_PROVIDER_ROLE_MAP={"clerk":"owner","auth0":"member"}

# AUTHZ: comma-separated emails granted platform-staff (cross-tenant CMS, platform revenue
# metrics). This is the ONLY way to confer platform staff — never granted via signup/webhook.
# PLATFORM_ADMIN_EMAILS is applied idempotently at boot (autoMigrate) and by migrate-authz-hardening.js.
PLATFORM_ADMIN_EMAILS=

# LOG-02/LOG-03: dev-only — set to 'true' to print reset/invite links to the console when no
# email webhook is configured. NEVER set in production (production fails closed instead).
ALLOW_INSECURE_EMAIL_LOGGING=false

# FILE-01: colon-separated absolute base directories an Obsidian vault_path may resolve inside.
# If unset, Obsidian local-vault sync is DISABLED (no arbitrary local file reads).
# OBSIDIAN_VAULT_ROOTS=/Users/me/vaults:/srv/obsidian

# GitHub skill import (Settings → Shared Skills → "Import from GitHub").
# Reads public SKILL.md files via api.github.com. STRONGLY RECOMMENDED in
# production: with no token, GitHub allows only 60 requests/HOUR keyed by the
# server's IP — a budget SHARED across ALL users, so imports throttle globally
# (error: github_rate_limited) after only a handful of tries. An authenticated
# token raises this to 5,000 requests/hour. For PUBLIC repos the token needs NO
# scopes at all (a classic PAT with zero scopes is safest). GH_TOKEN is accepted
# as an alias.
# GITHUB_TOKEN=ghp_...

# Slack Integration (optional, only if using Slack features)
# SLACK_CLIENT_ID=...
# SLACK_CLIENT_SECRET=...
# SLACK_SIGNING_SECRET=...
# SLACK_OAUTH_STATE_SECRET=...

# Google Context Sources (optional as a group; required together to enable Drive, Calendar, and Gmail)
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...
# GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/context/integrations/google/callback
# GOOGLE_OAUTH_STATE_SECRET=... # Generate a high-entropy secret for signed OAuth state

# Zendesk Integration (optional, only if using Zendesk enrichment)
# ZENDESK_CLIENT_ID=...
# ZENDESK_CLIENT_SECRET=...

# Intercom Integration (optional, only if using Intercom enrichment)
# INTERCOM_CLIENT_ID=...
# INTERCOM_CLIENT_SECRET=...

# [HOSTED-ONLY] PostHog — mirrors server-side product/MCP/revenue events into PostHog so the
# full signup -> onboarding -> activation -> upgrade funnel lives alongside web
# analytics. IMPORTANT: while POSTHOG_API_KEY is unset, getClient() returns null
# and EVERY server/MCP/revenue capture is a silent no-op — mcp_initialize,
# mcp_tool_call/start_session, purchase_completed, upgrade_checkout_started and
# $identify will NOT appear in PostHog and the product funnel is unmeasurable.
# Set this in production. Use the project's "Project API Key" (phc_...).
# The dashboard/marketing browser key is separate: NEXT_PUBLIC_POSTHOG_KEY.
# POSTHOG_API_KEY=phc_...
# POSTHOG_HOST=https://us.i.posthog.com

# [HOSTED-ONLY] Reddit Conversions API (CAPI) — mirrors the authoritative account_created
# signup to Reddit server-side (services/reddit.js), so ad-driven signups are
# attributed even when the browser pixel is blocked or lost to an OAuth redirect.
# Ships DORMANT: a no-op until BOTH are set. REDDIT_PIXEL_ID must equal the
# dashboard/marketing NEXT_PUBLIC_REDDIT_PIXEL_ID (the `a2_…` advertiser id) so
# the pixel + CAPI events dedupe on conversion_id. The access token is the
# non-expiring "conversion access token" from Reddit Ads > Events Manager.
# REDDIT_PIXEL_ID=a2_...
# REDDIT_CONVERSIONS_ACCESS_TOKEN=...

# [HOSTED-ONLY] Google Ads offline conversions — mirrors the authoritative account_created
# signup to Google Ads server-side (services/googleAds.js) for GOOGLE-OAUTH
# signups, which fire NO client conversion (the marketing origin can't set the
# app-origin dd_signup_pending flag). Uploads an offline click conversion keyed
# on the gclid/wbraid/gbraid carried through Clerk unsafeMetadata.
#
# NOTE: these are UNRELATED to the GOOGLE_CLIENT_ID/SECRET above (those are for
# Google context sources — Drive/Calendar/Gmail). Different Google product, own
# credentials. The client-side Google Ads account id is separate again:
# NEXT_PUBLIC_GOOGLE_ADS_ID (AW-...) in the marketing/dashboard Vercel env.
#
# Ships DORMANT: a no-op until ALL of DEVELOPER_TOKEN + CLIENT_ID + CLIENT_SECRET
# + REFRESH_TOKEN + CUSTOMER_ID + SIGNUP_CONVERSION_ACTION_ID are set, and a
# per-signup no-op unless the signup carried a Google click id.
#
#   DEVELOPER_TOKEN            Google Ads > Tools > API Center (apply once for access).
#   CLIENT_ID / CLIENT_SECRET  An OAuth2 client (Google Cloud console) with the
#                              https://www.googleapis.com/auth/adwords scope.
#   REFRESH_TOKEN              Mint once: `node scripts/mint-google-ads-refresh-token.mjs`
#                              (runs the consent flow as a user with Ads access).
#   CUSTOMER_ID                The 10-digit Ads account id, DIGITS ONLY (no dashes).
#   SIGNUP_CONVERSION_ACTION_ID  Numeric id of an import-enabled conversion action.
#   LOGIN_CUSTOMER_ID          Optional — manager/MCC id (digits only), if applicable.
#   SIGNUP_VALUE / CURRENCY    Optional — proxy conversion value + currency (default USD).
# GOOGLE_ADS_DEVELOPER_TOKEN=...
# GOOGLE_ADS_CLIENT_ID=....apps.googleusercontent.com
# GOOGLE_ADS_CLIENT_SECRET=...
# GOOGLE_ADS_REFRESH_TOKEN=1//...
# GOOGLE_ADS_CUSTOMER_ID=1234567890
# GOOGLE_ADS_SIGNUP_CONVERSION_ACTION_ID=987654321
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# GOOGLE_ADS_SIGNUP_VALUE=
# GOOGLE_ADS_CURRENCY=USD
#
# SETUP conversion — the person's AI tool actually received its first brief
# (first_sync_completed), uploaded once per person with the click id stored on
# their account_created event; orderId `<user_id>:setup` dedups retries. This is
# the conversion to make PRIMARY for bidding. A no-op until the action id is set
# (needs the credentials above; does not need SIGNUP_CONVERSION_ACTION_ID).
#   SETUP_CONVERSION_ACTION_ID  Numeric id of an import-enabled ("Import > other
#                               data sources > track conversions from clicks")
#                               conversion action.
#   SETUP_VALUE                 Optional conversion value for a setup.
# GOOGLE_ADS_SETUP_CONVERSION_ACTION_ID=
# GOOGLE_ADS_SETUP_VALUE=

# Resend — transactional email. Ships dormant: the weekly activity-digest email
# (the retention return-trigger; see services/email/weeklyDigest.js) is skipped
# entirely until RESEND_API_KEY is set. RESEND_FROM must be a Resend-verified
# sender. DASHBOARD_URL / PUBLIC_API_URL build the "resume" + unsubscribe links.
# RESEND_API_KEY=re_...
# RESEND_FROM=DeerDawn <hello@deerdawn.com>

# [HOSTED-ONLY] The morning-after brief (services/email/morningAfterBrief.js, activation plan
# Thing 3f): the morning after a person's first save, their own brief by plain
# text from John's address, plus one reminder 3 days later if they have not come
# back. OFF unless this is "true" — deploying the code sends nothing.
# MORNING_AFTER_BRIEF_ENABLED=false
# MORNING_AFTER_BRIEF_HOUR_UTC=14          # start of the daily send window
# MORNING_AFTER_BRIEF_WINDOW_HOURS=4       # length of that window
# MORNING_AFTER_BRIEF_FROM=John Gilbert <john@deerdawn.com>
# MORNING_AFTER_BRIEF_MAX_PER_RUN=200

# Physical postal address injected into every outbound email (CAN-SPAM 7704(a)(5)).
# Defaults to the address published on /terms, /privacy and /dpa.
# DEERDAWN_POSTAL_ADDRESS=DeerDawn Inc., 1209 Orange Street, Wilmington, DE 19801, USA
# DASHBOARD_URL=https://app.deerdawn.com
# PUBLIC_API_URL=https://api.deerdawn.com

# [HOSTED-ONLY] Resend delivery webhooks -> PostHog (routes/webhooks-resend.js). Turns
# "23 activation emails sent, 0 activations" into a readable funnel: delivered ->
# opened -> clicked, split by email_type. Without it there is no way to tell a
# deliverability problem from an attention problem from a landing problem.
#
# TWO manual steps, both in the Resend dashboard — the code alone is not enough:
#   1. Settings -> Webhooks -> add an endpoint at
#      https://api.deerdawn.com/api/v1/webhooks/resend and subscribe to
#      email.delivered, email.opened, email.clicked, email.bounced,
#      email.complained. Copy the signing secret here.
#   2. Domains -> deerdawn.com -> enable Open Tracking and Click Tracking.
#      Open/click events DO NOT FIRE until these are on, so the endpoint would
#      sit there receiving only delivered/bounced and quietly look "fine".
# Note that click tracking rewrites links in outgoing mail, which some strict
# spam filters weigh; watch the bounce rate after enabling.
# RESEND_WEBHOOK_SECRET=whsec_...

# ─── Sentry (error tracking) [optional; HOSTED uses it] ──────────────────────
#
# Server exceptions report to Sentry as of 2026-09-01 (services/errorReporting.js).
# PostHog keeps product events and its replay linkage; it no longer captures
# exceptions, so an error has one issue history rather than two partial ones.
#
# Set on Fly with:  fly secrets set SENTRY_DSN=... -a my-app
#
# Leave unset locally and in tests. src/instrument.js guards init on it, so the
# SDK switches off rather than buffering events with nowhere to send them.
# SENTRY_DSN=https://<key>@o<org>.ingest.us.sentry.io/<project>

# Names the environment on the issue. Defaults to NODE_ENV when unset.
# SENTRY_ENVIRONMENT=production

# Ties an issue to the deploy that introduced it, which is what makes a
# regression legible as a regression rather than as a new bug. Falls back to
# FLY_MACHINE_VERSION, which Fly sets automatically — so this is optional
# unless you want release names to match a git sha.
# SENTRY_RELEASE=

# NOTE ON TRACING. src/instrument.js sets skipOpenTelemetrySetup and leaves
# tracesSampleRate unset, on purpose. @sentry/node v8+ is built on OpenTelemetry
# and registers its own NodeSDK by default, and this API already registers one
# in config/tracing.js. Two SDKs racing for the global tracer provider is not a
# merge — the loser silently stops producing spans. Sentry is errors here;
# spans stay with OpenTelemetry. Do not add a tracesSampleRate without reading
# that file first.

# ORG SLUG. There are two Sentry orgs on this account: `deerdawn` (holds one
# stray `react-native` project from an aborted onboarding run, nothing else) and
# `deerdawn-ft`, which holds all three real projects — deerdawn-api,
# deerdawn-dashboard, deerdawn-marketing. Use deerdawn-ft. Quota and plan are
# per-org, so a token or DSN from the wrong one fails in a confusing way.
