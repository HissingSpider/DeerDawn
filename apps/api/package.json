{
  "name": "deerdawn-api",
  "version": "1.0.0",
  "description": "DeerDawn session memory API — briefs every new AI session with your project's current state.",
  "main": "src/server.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "start": "node src/server.js",
    "migrate": "node scripts/migrate.js",
    "migrate:authz": "node scripts/migrate-authz-hardening.js",
    "migrate:invite-code": "node scripts/migrate-invite-code.js",
    "seed": "node scripts/seed.js",
    "lint": "eslint .",
    "check:client-metadata": "node scripts/check-client-metadata-drift.js",
    "verify:context-sync": "bash scripts/verify-context-sync-stack.sh",
    "load": "node scripts/test-latency.js http://localhost:8080 dev-key",
    "baseline:multi-agent": "node scripts/multi-agent-baseline.js",
    "speed-test": "node scripts/speed-test.js http://localhost:8080",
    "perf:regression": "node scripts/speed-test.js --profile=regression --output=json --out-file=perf-report.json",
    "test:e2e": "bash scripts/run-db-test.sh node --test --test-timeout=120000 tests/integration/context-sync-e2e.test.js",
    "test:integration:db": "bash scripts/run-db-test.sh bash -lc 'node tests/integration/signup-pricing.test.js && node tests/integration/api-keys-lifecycle.test.js && node tests/integration/context-sync-api.test.js && node tests/integration/context-sync-tenant-isolation.test.js'",
    "test:layer0": "bash scripts/run-db-test.sh node --test --test-timeout=60000 tests/layer0-infrastructure.test.js",
    "test:layer1": "bash scripts/run-db-test.sh node --test --test-timeout=60000 tests/layer1-auth.test.js",
    "test:layer2": "bash scripts/run-db-test.sh node --test --test-timeout=60000 tests/layer2-billing.test.js",
    "test:layer3": "bash scripts/run-db-test.sh node --test --test-timeout=60000 tests/layer3-context-sync.test.js",
    "test:layer4": "bash scripts/run-db-test.sh node --test --test-timeout=60000 tests/layer4-workspace.test.js",
    "test:layer6": "bash scripts/run-db-test.sh node --test --test-timeout=60000 tests/layer6-tenant-isolation.test.js",
    "test:layer7": "bash scripts/run-db-test.sh node --test --test-timeout=60000 tests/layer7-security.test.js",
    "test:layer8": "bash scripts/run-db-test.sh node --test --test-timeout=120000 tests/layer8-performance.test.js",
    "test:layer9": "bash scripts/run-db-test.sh node --test --test-timeout=120000 tests/layer9-e2e-flows.test.js",
    "test:layers": "bash scripts/run-db-test.sh bash tests/run-all-layers.sh all",
    "test:behavioral": "bash scripts/run-db-test.sh bash -lc 'node --test --test-concurrency=1 --test-timeout=180000 $(node scripts/test-suites.js behavioral)'",
    "test:mcp-review": "bash scripts/run-db-test.sh bash -lc 'node --test --test-timeout=120000 $(node scripts/test-suites.js review)'",
    "test": "bash scripts/run-db-test.sh bash -lc 'node --test --test-concurrency=1 --test-timeout=180000 $(node scripts/test-suites.js default)'",
    "openapi:export": "node -e \"console.log(JSON.stringify(require('./src/docs/registry').generateOpenApiSpec(), null, 2))\" > openapi.json",
    "test:layer10": "bash scripts/run-db-test.sh node --test --test-timeout=120000 tests/layer10-complete-journey.test.js"
  },
  "keywords": [],
  "author": "",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "commonjs",
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "@clerk/backend": "^2.26.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.219.0",
    "@opentelemetry/resources": "^2.8.0",
    "@opentelemetry/sdk-node": "^0.219.0",
    "@opentelemetry/sdk-trace-node": "^2.8.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "@sentry/node": "^10.73.0",
    "@slack/web-api": "^7.13.0",
    "axios": "^1.13.5",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "express": "^4.22.3",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "http-terminator": "^3.2.0",
    "ioredis": "^5.9.1",
    "ipaddr.js": "^2.3.0",
    "jsonwebtoken": "^9.0.2",
    "lru-cache": "^10.4.3",
    "opossum": "^9.0.0",
    "pg": "^8.11.3",
    "posthog-node": "^5.38.2",
    "prom-client": "^15.1.3",
    "rate-limit-redis": "^4.3.1",
    "stripe": "^20.1.2",
    "svix": "^1.84.1",
    "swagger-ui-express": "^5.0.0",
    "uuid": "^11.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "eslint": "^9.39.2",
    "supertest": "^7.2.2"
  }
}
