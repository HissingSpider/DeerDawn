{
  "slo": {
    "description": "Marketing-grade latency claim validation",
    "warmup_seconds": 30,
    "duration_seconds": 180,
    "concurrency": 10,
    "ramp_seconds": 15,
    "success_only": true,
    "fail_on_429": true,
    "max_error_rate": 0.001,
    "thresholds": {
      "p95_success_ms": 100,
      "p99_success_ms": 200
    }
  },
  "regression": {
    "description": "CI sanity check on every deploy",
    "warmup_seconds": 10,
    "duration_seconds": 60,
    "concurrency": 5,
    "ramp_seconds": 5,
    "success_only": true,
    "fail_on_429": true,
    "max_error_rate": 0.002,
    "thresholds": {
      "p95_success_ms": 150,
      "p99_success_ms": 300
    }
  },
  "capacity": {
    "description": "Find the knee point where performance degrades",
    "warmup_seconds": 20,
    "duration_seconds": 300,
    "ramp_concurrency": true,
    "concurrency_start": 5,
    "concurrency_end": 50,
    "step_every_seconds": 30,
    "success_only": true,
    "stop_conditions": {
      "p95_success_ms": 200,
      "max_error_rate": 0.01,
      "max_429_count": 0
    }
  },
  "stress": {
    "description": "High load stability test (100 concurrent users)",
    "warmup_seconds": 30,
    "duration_seconds": 300,
    "concurrency": 100,
    "ramp_seconds": 30,
    "success_only": true,
    "fail_on_429": false,
    "max_error_rate": 0.05,
    "thresholds": {
      "p95_success_ms": 500,
      "p99_success_ms": 1000
    }
  },
  "legacy": {
    "description": "Previous simple speed test behavior",
    "warmup_seconds": 0,
    "duration_seconds": 10,
    "concurrency": 20,
    "target_requests": 500
  }
}
