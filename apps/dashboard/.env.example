# Dashboard (apps/dashboard) environment.
#
# IMPORTANT: every NEXT_PUBLIC_* var is inlined into the client bundle at BUILD
# time, not read at request time. They must be present in the build environment
# (e.g. the Vercel project's Environment Variables, available to the Build step)
# and the app must be redeployed for changes to take effect. A missing/blank
# NEXT_PUBLIC_* value compiles to '' and silently disables the feature that
# reads it.

# SELF-HOSTING: you do not need this file. The prebuilt dashboard image is built
# with placeholder URLs and configured at container start from
# DEERDAWN_PUBLIC_URL (see apps/dashboard/Dockerfile and docs/self-hosting.md).
# Leave every [HOSTED-ONLY] value unset in a self-hosted build: unset means the
# local email/password sign-in and no third-party analytics ids in the bundle.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://api.deerdawn.com
NEXT_PUBLIC_APP_URL=https://app.deerdawn.com
NEXT_PUBLIC_SITE_URL=https://deerdawn.com

# ---------------------------------------------------------------------------
# Auth (Clerk) [HOSTED-ONLY]
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_xxx
NEXT_PUBLIC_CLERK_JWT_TEMPLATE=

# ---------------------------------------------------------------------------
# Analytics & Google Ads conversions [HOSTED-ONLY]
# ---------------------------------------------------------------------------
# gtag.js base config ids. The Google Ads id is the AW- number; GA4 is the G-
# property. Both are emitted by /gtag-init.js when set. Neither has a default in
# code: unset means no tag at all (what a self-hosted build wants).
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXXXX
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX

# Reddit Pixel advertiser id (the `a2_…` value from Reddit Ads > Events Manager).
# Emits the base pixel (PageVisit) via /rdt-init.js and lets src/lib/reddit.ts
# fire the SignUp conversion. Blank = a silent no-op (ships dormant). Set the same
# value as REDDIT_PIXEL_ID in the API so the pixel + server CAPI dedupe.
NEXT_PUBLIC_REDDIT_PIXEL_ID=a2_XXXXXXXXX

# Per-conversion-action labels — the part AFTER the slash in `AW-XXXX/<label>`.
# Each must EXACTLY match the label of the corresponding NATIVE (Website /
# Google tag) conversion action in the Google Ads UI, or the conversion fires
# to a non-existent send_to and the action stays "Misconfigured".
#   - PURCHASE_LABEL    -> the native "Purchase" conversion action
#   - SIGNUP_LABEL      -> the native "Sign-up" conversion action
#   - FIRST_SYNC_LABEL  -> the native first-sync / activation conversion action
# Leaving any of these blank makes fireConversion() a silent no-op for that
# event (see src/lib/gtag.ts). None of them has a default in code.
#   - CONNECT_ATTEMPTED_LABEL -> the "Connect Attempted" conversion action
NEXT_PUBLIC_GADS_PURCHASE_LABEL=
NEXT_PUBLIC_GADS_SIGNUP_LABEL=
NEXT_PUBLIC_GADS_FIRST_SYNC_LABEL=
NEXT_PUBLIC_GADS_CONNECT_ATTEMPTED_LABEL=

# PostHog product analytics.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ---------------------------------------------------------------------------
# Governance host (optional)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GOVERNANCE_SITE_URL=
NEXT_PUBLIC_GOVERNANCE_APP_URL=

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
# Set to "true" to forward client errors to the logging endpoint.
NEXT_PUBLIC_ENABLE_ERROR_LOGGING=

# ── Local OAuth (Google sign-in) ─────────────────────────────────────────────
# By default a local run uses the email/password fallback, so the app works with
# no Clerk account at all. That default also made the Google/OAuth path
# impossible to exercise locally, which is how an already-signed-in dead end
# reached production (2026-08-27).
#
# To click through real Google sign-in locally, set BOTH:
#   NEXT_PUBLIC_AUTH_MODE=clerk
#   NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...   <- DEVELOPMENT instance key
#
# It must be a pk_test_ (development) key: dev instances allow localhost origins
# and ship with Clerk's shared Google credentials, so "Continue with Google"
# works without registering your own Google OAuth app. A pk_live_ key will not
# work against localhost.
#
# Get it from the Clerk dashboard -> your app -> Developers -> API keys, with
# the instance switcher set to Development.
NEXT_PUBLIC_AUTH_MODE=

# Clerk's optional telemetry ping is blocked by the site CSP and logs a console
# error on every local page load. Disable the call rather than widening CSP to
# allow a third-party analytics domain.
CLERK_TELEMETRY_DISABLED=1

# ─── Sentry (error tracking + replay) [HOSTED-ONLY] ─────────────────────────
#
# Errors and session replay for this app live in Sentry as of 2026-09-01;
# PostHog kept product analytics and stopped recording sessions here. See
# src/instrumentation-client.ts for why replay moved (the short version: this
# app recorded 100% of sessions and only masked form inputs, so rendered brief
# content was going into the recordings).
#
# Leave the DSN unset locally. Every Sentry.init() is guarded on it, so the SDK
# switches off entirely rather than half-initialising against nothing.
NEXT_PUBLIC_SENTRY_DSN=

# Names the environment on the issue so a staging crash is not filed against
# production. Vercel sets NODE_ENV=production for previews too, so set this
# explicitly per Vercel environment: production / preview.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=

# ── Build-time only. Vercel build env, NOT the browser. ──
#
# Without these the build still succeeds and errors still report — you just get
# stack traces pointing at minified chunk offsets instead of real files and
# lines, which is most of the reason to run Sentry over what we already had.
#
# SENTRY_AUTH_TOKEN needs the project:releases scope. Create it under
# Settings -> Developer Settings -> Organization Tokens (an ORG token, not a
# personal one — a personal token dies with the person who made it).
SENTRY_ORG=deerdawn-ft
SENTRY_PROJECT=deerdawn-dashboard
SENTRY_AUTH_TOKEN=

# ORG SLUG. There are two Sentry orgs on this account: `deerdawn` (holds one
# stray `react-native` project from an aborted onboarding run, nothing else) and
# `deerdawn-ft`, which holds all three real projects — deerdawn-api,
# deerdawn-dashboard, deerdawn-marketing. Use deerdawn-ft. Quota and plan are
# per-org, so a token or DSN from the wrong one fails in a confusing way.
