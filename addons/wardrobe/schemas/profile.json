{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Wardrobe profile (one record per person)",
  "type": "object",
  "properties": {
    "preferences": { "type": "array", "items": { "type": "string", "maxLength": 200 }, "maxItems": 30, "description": "Standing rules: nothing tight, no logos" },
    "sizes": { "type": "object", "additionalProperties": { "type": "string", "maxLength": 20 } },
    "notes": { "type": ["string", "null"], "maxLength": 2000 }
  }
}
