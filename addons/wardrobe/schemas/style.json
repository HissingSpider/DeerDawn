{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Wardrobe style",
  "type": "object",
  "required": ["name"],
  "properties": {
    "name": { "type": "string", "maxLength": 60 },
    "description": { "type": ["string", "null"], "maxLength": 1000 },
    "do": { "type": "array", "items": { "type": "string", "maxLength": 200 }, "maxItems": 20 },
    "dont": { "type": "array", "items": { "type": "string", "maxLength": 200 }, "maxItems": 20 },
    "palette": { "type": "array", "items": { "type": "string", "maxLength": 30 }, "maxItems": 12, "description": "Plain colour names" },
    "reference_outfit_ids": { "type": "array", "items": { "type": "string" }, "maxItems": 20 }
  }
}
