{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Wardrobe item",
  "type": "object",
  "required": ["ref", "name", "status"],
  "properties": {
    "ref": { "type": "string", "maxLength": 12, "description": "Short handle the agent uses, e.g. i3k9q" },
    "name": { "type": "string", "maxLength": 120 },
    "category": { "enum": ["top", "bottom", "outerwear", "shoes", "accessory", "one-piece", null] },
    "subcategory": { "type": ["string", "null"], "maxLength": 60 },
    "colors": { "type": "array", "items": { "type": "string", "maxLength": 30 }, "maxItems": 6 },
    "pattern": { "type": ["string", "null"], "maxLength": 40 },
    "material": { "type": ["string", "null"], "maxLength": 60 },
    "formality": { "type": ["integer", "null"], "minimum": 1, "maximum": 5 },
    "warmth": { "type": ["integer", "null"], "minimum": 1, "maximum": 5 },
    "seasons": { "type": "array", "items": { "enum": ["spring", "summer", "autumn", "winter"] }, "maxItems": 4 },
    "fit": { "type": ["string", "null"], "maxLength": 40 },
    "brand": { "type": ["string", "null"], "maxLength": 60 },
    "size": { "type": ["string", "null"], "maxLength": 20 },
    "notes": { "type": ["string", "null"], "maxLength": 2000 },
    "status": { "enum": ["active", "stored", "laundry", "repair", "donated", "wishlist"] },
    "location": { "type": ["string", "null"], "maxLength": 60, "description": "Free label: dorm, home, storage unit" },
    "acquired": { "type": ["string", "null"], "maxLength": 10, "description": "YYYY-MM-DD or YYYY-MM" },
    "cost": { "type": ["number", "null"], "minimum": 0 },
    "photo_ids": { "type": "array", "items": { "type": "string" }, "description": "Attachment ids in display order; the first is the cover" },
    "removed_photo_ids": { "type": "array", "items": { "type": "string" } },
    "wear_count": { "type": "integer", "minimum": 0 },
    "last_worn": { "type": ["string", "null"], "maxLength": 10 },
    "description": { "type": ["string", "null"], "maxLength": 400, "description": "One-sentence written description, from the vision model or the agent" },
    "tags_confirmed": { "type": "boolean" },
    "tag_source": { "enum": ["vision", "agent", "user", null] },
    "tag_error": { "type": ["string", "null"], "maxLength": 200 }
  }
}
