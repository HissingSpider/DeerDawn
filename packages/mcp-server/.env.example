# Deerdawn MCP Server Configuration

# Required: API endpoint URL. The hosted service is https://api.deerdawn.com;
# for a self-hosted DeerDawn use its DEERDAWN_PUBLIC_URL (e.g. https://deerdawn.example.com
# or http://localhost:3000), which serves the API on the same origin.
DEERDAWN_API_URL=https://api.deerdawn.com

# Required: API key (must start with dd_ and be at least 11 characters)
# Get your API key from: https://app.deerdawn.com/setup#keys (self-hosted: <your URL>/setup#keys)
DEERDAWN_API_KEY=dd_prod_your_api_key_here

# Optional: Organization ID
DEERDAWN_ORG_ID=org-abc123

# Optional: Environment (sandbox or production)
DEERDAWN_ENVIRONMENT=sandbox

# Optional: Enable response caching (default: true)
DEERDAWN_CACHE_ENABLED=true

# Optional: Cache TTL in seconds (1-3600, default: 60)
DEERDAWN_CACHE_TTL_SECONDS=60

# Optional: Maximum retry attempts (0-5, default: 3)
DEERDAWN_MAX_RETRIES=3

# Optional: Initial retry backoff in ms (100-10000, default: 1000)
DEERDAWN_RETRY_BACKOFF_MS=1000
